<Window x:Class="HwPulse.ColorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HwPulse"
        Title="HwPulse" Width="640" Height="440" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Slider con la pista pintada (el degradado del canal que se edita) -->
        <Style x:Key="HslSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="10" CornerRadius="5" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="Transparent" Stroke="White" StrokeThickness="2.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.8"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila de la lista de colores -->
        <Style x:Key="ColorItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="colors"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,8" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1D1D1D"/>
                                <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
        <DockPanel>
            <!-- Encabezado -->
            <Grid DockPanel.Dock="Top" Height="44" Margin="18,0,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ColorsTitle], Source={x:Static local:Loc.I}}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextStrong}"/>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Tag="{StaticResource IcClose}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Done_Click"/>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="18,0,18,12"
                       Text="{Binding [ColorsSub], Source={x:Static local:Loc.I}}"/>

            <!-- Pie -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="Done_Click"
                            Content="{Binding [Done], Source={x:Static local:Loc.I}}"/>
                    <Button Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Click="Reset_Click"
                            Content="{Binding [ResetColors], Source={x:Static local:Loc.I}}"/>
                </DockPanel>
            </Border>

            <Grid Margin="18,0,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Lista de colores -->
                <StackPanel x:Name="List"/>

                <!-- Editor HSL -->
                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16,14">
                    <StackPanel>
                        <DockPanel>
                            <Border x:Name="Swatch" Width="44" Height="44" CornerRadius="8" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"/>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="EditingName" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="HEX" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="HexBox" Style="{StaticResource SearchBox}" Width="96" FontFamily="{StaticResource MonoFont}"
                                             MaxLength="7" KeyDown="Hex_KeyDown" LostFocus="Hex_LostFocus"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding [Hue], Source={x:Static local:Loc.I}}"/>
                            <Slider x:Name="HueSlider" Grid.Column="1" Style="{StaticResource HslSlider}" Minimum="0" Maximum="360" ValueChanged="Hsl_Changed"/>
                            <TextBox x:Name="HueBox" Grid.Column="2" Style="{StaticResource NumBox}" Tag="h" KeyDown="HslBox_KeyDown" LostFocus="HslBox_LostFocus"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource Body}" Text="{Binding [Saturation], Source={x:Static local:Loc.I}}"/>
                            <Slider x:Name="SatSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource HslSlider}" Minimum="0" Maximum="100" ValueChanged="Hsl_Changed"/>
                            <TextBox x:Name="SatBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource NumBox}" Tag="s" KeyDown="HslBox_KeyDown" LostFocus="HslBox_LostFocus"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource Body}" Text="{Binding [Lightness], Source={x:Static local:Loc.I}}"/>
                            <Slider x:Name="LightSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource HslSlider}" Minimum="0" Maximum="100" ValueChanged="Hsl_Changed"/>
                            <TextBox x:Name="LightBox" Grid.Row="2" Grid.Column="2" Style="{StaticResource NumBox}" Tag="l" KeyDown="HslBox_KeyDown" LostFocus="HslBox_LostFocus"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
