<Application x:Class="HwPulse.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Paleta: grises neutros, un solo acento y colores de estado apagados. -->
        <Color x:Key="AccentColor">#5B9BD5</Color>
        <SolidColorBrush x:Key="Bg" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="Sidebar" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="Surface" Color="#111111"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#161616"/>
        <SolidColorBrush x:Key="Hover" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="Line" Color="#262626"/>
        <SolidColorBrush x:Key="LineStrong" Color="#333333"/>
        <SolidColorBrush x:Key="Text" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="TextStrong" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="Muted" Color="#A3A3A3"/>
        <SolidColorBrush x:Key="Faint" Color="#737373"/>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="Track" Color="#262626"/>
        <SolidColorBrush x:Key="SeriesTemp" Color="#E5584F"/>
        <SolidColorBrush x:Key="SeriesClock" Color="#5B9BD5"/>
        <SolidColorBrush x:Key="SeriesLoad" Color="#6CC287"/>
        <SolidColorBrush x:Key="SeriesMem" Color="#9C8BD0"/>
        <!-- Color de CPU y GPU: se cambia al color de la marca detectada (Intel, AMD, NVIDIA) al arrancar -->
        <SolidColorBrush x:Key="CpuColor" Color="#5B9BD5"/>
        <SolidColorBrush x:Key="GpuColor" Color="#6CC287"/>

        <!-- Inter va incluida en la app (carpeta Fonts); Segoe UI queda de respaldo. -->
        <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#Inter, Segoe UI</FontFamily>
        <FontFamily x:Key="NumFont">pack://application:,,,/Fonts/#Inter, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <!-- Texto -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        </Style>
        <!-- Etiqueta diminuta en mayúsculas bajo un valor (USAGE, TEMP, CLOCK) -->
        <Style x:Key="Micro" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Num" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <!-- Panel de sección -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <!-- Botones de la barra de título -->
        <!-- Botones de ventana: el Tag lleva la geometría del icono -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1" Width="10" Height="10" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1" Width="10" Height="10" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón plano (barra de título: interruptor rápido del overlay) -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón pequeño con borde (p. ej. "Abrir") -->
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                CornerRadius="6" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pestañas: texto con subrayado de 2 px en la activa -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            <Border x:Name="line" Height="2" VerticalAlignment="Bottom" Margin="10,0" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
                                <Setter TargetName="line" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Control segmentado -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A2F36"/>
                                <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Interruptor -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="34" Height="18" CornerRadius="9" Background="{StaticResource Track}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                            <Ellipse x:Name="knob" Width="12" Height="12" Fill="{StaticResource Muted}" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="knob" Property="Fill" Value="White"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de progreso fina -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="{StaticResource Track}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1.5"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1.5" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider minimalista -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="e" Width="12" Height="12" Fill="{StaticResource TextStrong}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="e" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FillRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource FillRepeat}" Background="{StaticResource Accent}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource FillRepeat}" Background="{StaticResource Track}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caja de texto -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <Grid>
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Faint}" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Casilla de verificación oscura (lista de sensores de temperatura) -->
        <Style x:Key="CheckRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="8,6" Margin="0,1,8,1">
                            <DockPanel>
                                <Border x:Name="box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                                        BorderBrush="{StaticResource LineStrong}" Background="{StaticResource Bg}" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path x:Name="tick" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="16" Height="16" Margin="-1.5" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caja numérica pequeña junto a los sliders (Enter o salir del campo para aplicar) -->
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource SearchBox}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="MaxLength" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Barra de desplazamiento fina -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="b" CornerRadius="3" Background="#3A4048" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4C535C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tecla (atajos) -->
        <Style x:Key="KeyChip" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="{StaticResource Bg}"/>
        </Style>

        <!-- Iconos de línea (16×16) -->
        <Geometry x:Key="IcOverview">M2.5,2.5 H7 V7 H2.5 Z M9,2.5 H13.5 V7 H9 Z M2.5,9 H7 V13.5 H2.5 Z M9,9 H13.5 V13.5 H9 Z</Geometry>
        <Geometry x:Key="IcCpu">M4,4 H12 V12 H4 Z M6.5,6.5 H9.5 V9.5 H6.5 Z M6,1.5 V4 M10,1.5 V4 M6,12 V14.5 M10,12 V14.5 M1.5,6 H4 M1.5,10 H4 M12,6 H14.5 M12,10 H14.5</Geometry>
        <Geometry x:Key="IcGpu">M1.5,4 H14.5 V11 H1.5 Z M7.5,7.5 A2,2 0 1 1 11.5,7.5 A2,2 0 1 1 7.5,7.5 Z M3.5,6 H5 M3.5,8.5 H5 M3,11 V13.5 H8 V11</Geometry>
        <Geometry x:Key="IcRam">M1.5,4.5 H14.5 V10.5 H1.5 Z M4,6.5 V8.5 M6.5,6.5 V8.5 M9.5,6.5 V8.5 M12,6.5 V8.5 M3,10.5 V12.5 M6,10.5 V12.5 M10,10.5 V12.5 M13,10.5 V12.5</Geometry>
        <Geometry x:Key="IcDisk">M2,9 H14 V13.5 H2 Z M2,9 L4,3 H12 L14,9 M10.5,11.25 H12</Geometry>
        <Geometry x:Key="IcNet">M3,13.5 V10.5 M6.33,13.5 V8 M9.66,13.5 V5.5 M13,13.5 V2.5</Geometry>
        <Geometry x:Key="IcSensors">M6.5,9.5 V3.5 A1.5,1.5 0 0 1 9.5,3.5 V9.5 A3,3 0 1 1 6.5,9.5 Z M8,8 V11</Geometry>
        <Geometry x:Key="IcSettings">M2,4.5 H14 M2,8 H14 M2,11.5 H14 M5,3 V6 M10.5,6.5 V9.5 M7,10 V13</Geometry>
        <Geometry x:Key="IcTemp">M6.5,9.5 V3.5 A1.5,1.5 0 0 1 9.5,3.5 V9.5 A3,3 0 1 1 6.5,9.5 Z</Geometry>
        <Geometry x:Key="IcList">M2,4 H14 M2,8 H14 M2,12 H10</Geometry>
        <Geometry x:Key="IcPower">M9,1.5 L3.5,9 H8 L7,14.5 L12.5,7 H8 Z</Geometry>
        <Geometry x:Key="IcChart">M2,13.5 H14 M2.5,11 L6,7 L9,9.5 L13.5,4</Geometry>
        <!-- Iconos por tipo de proceso -->
        <Geometry x:Key="IcApp">M2,3 H14 V13 H2 Z M2,6 H14 M4,4.5 H4.1 M5.7,4.5 H5.8</Geometry>
        <Geometry x:Key="IcGlobe">M8,2 A6,6 0 1 1 7.99,2 Z M2,8 H14 M8,2 C5.6,4.6 5.6,11.4 8,14 M8,2 C10.4,4.6 10.4,11.4 8,14</Geometry>
        <Geometry x:Key="IcChat">M2.5,3 H13.5 V10.5 H7 L4.5,13 V10.5 H2.5 Z M5.5,6.75 H10.5</Geometry>
        <Geometry x:Key="IcGamepad">M5,5 H11 C13.2,5 14.5,7.2 14.5,9.2 C14.5,11 13,11.8 12,11 L10.5,9.5 H5.5 L4,11 C3,11.8 1.5,11 1.5,9.2 C1.5,7.2 2.8,5 5,5 Z M5,6.6 V8.6 M4,7.6 H6 M10.6,7.2 H10.7 M11.8,8.2 H11.9</Geometry>
        <Geometry x:Key="IcMusic">M6,11.5 V3.5 L13,2 V10 M6,11.5 A1.8,1.8 0 1 1 2.4,11.5 A1.8,1.8 0 1 1 6,11.5 Z M13,10 A1.8,1.8 0 1 1 9.4,10 A1.8,1.8 0 1 1 13,10 Z</Geometry>
        <Geometry x:Key="IcCode">M5.5,4.5 L2,8 L5.5,11.5 M10.5,4.5 L14,8 L10.5,11.5 M9,3 L7,13</Geometry>
        <Geometry x:Key="IcFolder">M2,4 H6.5 L8,5.5 H14 V12.5 H2 Z</Geometry>
        <!-- Iconos de ventana: los tres ocupan el mismo cuadro de 10×10 para quedar alineados -->
        <Geometry x:Key="IcMin">M0,5.5 H10</Geometry>
        <Geometry x:Key="IcMax">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
        <Geometry x:Key="IcClose">M0,0 L10,10 M10,0 L0,10</Geometry>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Navegación lateral -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4" Margin="8,1">
                            <Grid>
                                <Border x:Name="bar" Width="3" HorizontalAlignment="Left" CornerRadius="1.5" Margin="0,9" Background="Transparent"/>
                                <StackPanel Orientation="Horizontal" Margin="12,0,8,0">
                                    <Path x:Name="ic" Style="{StaticResource Icon}" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}"/>
                                    <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1D2126"/>
                                <Setter TargetName="bar" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
                                <Setter TargetName="ic" Property="Stroke" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Encabezado de panel con icono -->
        <Style x:Key="PanelIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Stroke" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Segmento pequeño (selector de rango de la gráfica) -->
        <Style x:Key="SegmentSmall" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>

        <!-- ToolTip oscuro -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E2226"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Application.Resources>
</Application>
