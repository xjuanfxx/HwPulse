<Window x:Class="HwPulse.ColorPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HwPulse"
        Title="HwPulse" SizeToContent="Height" Width="340" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Slider con la pista pintada (mismo estilo que el editor de colores) -->
        <Style x:Key="HslSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="10" CornerRadius="5" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="Transparent" Stroke="White" StrokeThickness="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16">
        <DockPanel>
            <Border x:Name="Swatch" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="7" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"/>
            <TextBox x:Name="HexBox" DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Width="96" FontFamily="{StaticResource MonoFont}"
                     VerticalAlignment="Center" KeyDown="Hex_KeyDown" LostFocus="Hex_LostFocus"/>
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Colores rápidos -->
        <WrapPanel x:Name="Palette" Margin="0,14,0,4"/>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Hint}" Text="H" VerticalAlignment="Center"/>
            <Slider x:Name="HueSlider" Grid.Column="1" Style="{StaticResource HslSlider}" Minimum="0" Maximum="360" ValueChanged="Hsl_Changed"/>
            <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Text="S" VerticalAlignment="Center"/>
            <Slider x:Name="SatSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource HslSlider}" Minimum="0" Maximum="100" ValueChanged="Hsl_Changed"/>
            <TextBlock Grid.Row="2" Style="{StaticResource Hint}" Text="L" VerticalAlignment="Center"/>
            <Slider x:Name="LightSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource HslSlider}" Minimum="0" Maximum="100" ValueChanged="Hsl_Changed"/>
        </Grid>

        <DockPanel Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="Ok_Click" Margin="8,0,0,0"
                    Content="{Binding [Done], Source={x:Static local:Loc.I}}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="Cancel_Click"
                    Content="{Binding [Cancel], Source={x:Static local:Loc.I}}"/>
            <Button x:Name="AutoBtn" Style="{StaticResource SmallButton}" Click="Auto_Click" HorizontalAlignment="Left"
                    Content="{Binding [OvAutoColor], Source={x:Static local:Loc.I}}" ToolTip="{Binding [OvAutoColorTip], Source={x:Static local:Loc.I}}"/>
        </DockPanel>
    </StackPanel>
</Window>
